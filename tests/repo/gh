#!/usr/bin/env bash
# A stand-in for gh, used by run.sh: answers the calls of repo.sh's
# pr-threads, pr-comments and resolve-thread from the JSON files beside it,
# through jq, and logs one line per call. GH_STUB_JQ is an option for jq,
# left unquoted so that an empty one adds nothing: run.sh sets it to -b
# (binary mode) where jq would otherwise end each line with a carriage
# return, which the real gh --jq does not.
#
# For pr-edit it answers "pr view --json body" and "pr edit" without jq. The
# pull request's number picks the answer. A successful "pr view" also writes
# a hint on standard error, as the real gh can. "pr edit" keeps the title and
# the description it was given in the folder GH_STUB_SENT, so that run.sh can
# compare them with what it sent. A failure is written as the real gh writes
# it for these commands: nothing on standard output, one message on standard
# error, and exit 1.
#
# It refuses a query that reads review threads any other way than
# reviewThreads(last: 100), so a script that reads another end of the list
# fails its test. For resolve-thread, the thread id picks the answer, and a
# failure is written as the real gh writes it: GitHub's JSON on standard
# output, gh's own message on standard error, and exit 1.
here="$(cd "$(dirname "$0")" && pwd)"
echo "${1:-} ${2:-}" >> "$GH_STUB_LOG"
case "${1:-} ${2:-}" in
  "pr view")
    case " $* " in
      *" --json body "*)
        # pr-edit asks for the description as it is now.
        case "$3" in
          21|24|25|26) printf 'Closes me/shop#12\n\n### Overview\nThe first version.\n\nBoard item: https://github.com/users/me/projects/1\n' ;;
          # Written on GitHub's page: each line ends with a carriage return.
          22) printf 'Some words first.\r\nCloses me/shop#12\r\n\r\nCloses the gap, with no issue named.\r\n' ;;
          23) printf '### Overview\nNo closing line here. It mentions that it Closes me/shop#12 in the middle.\n' ;;
          27) printf 'Closes me/shop#12\nCloses other/repo#3\n' ;;
          *) echo "GraphQL: Could not resolve to a PullRequest with the number of $3. (repository.pullRequest)" >&2; exit 1 ;;
        esac
        echo "hint: if you need to wait for this pull request, use gh event listen" >&2
        exit 0 ;;
    esac
    # repo.sh asks for the pull request's number and link, as one row.
    printf '%s\thttps://github.com/me/shop/pull/%s\n' "$3" "$3"
    exit 0 ;;
  "pr edit")
    number="$3"; title=""; body=""
    shift 3
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) title="$2"; shift 2 ;;
        --body-file) body="$2"; shift 2 ;;
        *) echo "unexpected argument for pr edit: $1" >&2; exit 1 ;;
      esac
    done
    [ -f "$body" ] || { echo "no description file: $body" >&2; exit 1; }
    case "$number" in
      24) echo "GraphQL: me does not have the correct permissions to execute \`UpdatePullRequest\` (updatePullRequest)" >&2; exit 1 ;;
      # gh's message as Windows writes it.
      25) printf 'GraphQL: Something went wrong while executing your query. (updatePullRequest)\r\n' >&2; exit 1 ;;
      26) exit 0 ;;
    esac
    printf '%s' "$title" > "$GH_STUB_SENT/title"
    cat "$body" > "$GH_STUB_SENT/body"
    echo "https://github.com/me/shop/pull/$number"
    exit 0 ;;
  "api graphql") shift 2 ;;
  *) echo "unexpected gh call: $*" >&2; exit 1 ;;
esac
query=""; filter=""; thread=""; number=""
while [ $# -gt 0 ]; do
  case "$1" in
    -f|-F)
      case "$2" in
        query=*) query="${2#query=}" ;;
        t=*) thread="${2#t=}" ;;
        i=*) number="${2#i=}" ;;
      esac
      shift 2 ;;
    --jq) filter="$2"; shift 2 ;;
    *) shift ;;
  esac
done

refused() { # refused <GitHub's error type> <message>
  printf '{"data":{"resolveReviewThread":null},"errors":[{"type":"%s","path":["resolveReviewThread"],"message":"%s"}]}' "$1" "$2"
  echo "gh: $2" >&2
  exit 1
}
answered() { # answered <true|false>
  jq ${GH_STUB_JQ:-} -r "$filter" <<< "{\"data\":{\"resolveReviewThread\":{\"thread\":{\"isResolved\":$1}}}}"
  exit 0
}

case "$query" in
  *resolveReviewThread*)
    case "$thread" in
      PRRT_ok) answered true ;;
      PRRT_stuck) answered false ;;
      PRRT_missing) refused NOT_FOUND "Could not resolve to a node with the global id of 'PRRT_missing'" ;;
      PRRT_forbidden) refused FORBIDDEN "me does not have the correct permissions to execute \`ResolveReviewThread\`" ;;
      PRRT_offline)
        # No answer at all, and a message of two lines without "gh: ".
        printf 'error connecting to api.github.com\ncheck your internet connection or https://githubstatus.com\n' >&2
        exit 1 ;;
      PRRT_silent) exit 1 ;;
      PRRT_windows)
        # gh's message as Windows writes it: each line ends with a carriage
        # return before the line break.
        printf '{"data":{"resolveReviewThread":null},"errors":[{"type":"NOT_FOUND"}]}'
        printf "gh: Could not resolve to a node with the global id of 'PRRT_windows'\r\n" >&2
        exit 1 ;;
      *) echo "unexpected thread id: $thread" >&2; exit 1 ;;
    esac ;;
  *"reviewThreads("*)
    rest="${query//reviewThreads(last: 100)/}"
    case "$rest" in
      *"reviewThreads("*)
        echo "unexpected query: review threads must be read with reviewThreads(last: 100)" >&2
        exit 1 ;;
    esac
    case "$query" in
      *"reviews(first"*) file="comments-$number" ;;
      *) file="threads-$number" ;;
    esac
    [ -f "$here/$file.json" ] || { echo "no fixture: $file.json" >&2; exit 1; }
    jq ${GH_STUB_JQ:-} -r "$filter" "$here/$file.json" ;;
  *) echo "unexpected query" >&2; exit 1 ;;
esac
